# Copy to .env and adjust. Every value has a default in compose.yaml.

# Host name and port the browser uses. If you change either, set DSEC_PUBLIC_ORIGIN to
# match, and rerun `FORCE=1 make dev-secrets` so the certificate covers the new name.
DSEC_HOSTNAME=localhost
DSEC_HTTPS_PORT=443
DSEC_PUBLIC_ORIGIN=https://localhost
# Interface the web port binds to. 127.0.0.1 keeps the development stack off the network.
DSEC_BIND_ADDRESS=127.0.0.1

# development: local accounts allowed. production: refuses local accounts (OIDC is M5).
DSEC_MODE=development
DSEC_LOCAL_ACCOUNTS=true
DSEC_LOG_LEVEL=INFO

# Image tag, and whether Compose builds images or pulls them (build | missing | always).
DSEC_VERSION=dev
DSEC_PULL_POLICY=build

# Building behind a TLS-inspecting proxy: path to its CA bundle. Build-time only.
# DSEC_BUILD_CA_FILE=/path/to/corporate-ca.pem
